{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kitsune",
  "version": "0.1.0",
  "identifier": "com.kitsune.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "Kitsune",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' tauri: asset:; img-src 'self' https: http: data: blob:; media-src 'self' http://127.0.0.1:* blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' tauri: ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420 http://127.0.0.1:*; frame-src http://127.0.0.1:* https://www.youtube.com https://www.dailymotion.com"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["kitsune"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/applications/com.kitsune.app.desktop": "linux/com.kitsune.app.desktop"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/applications/com.kitsune.app.desktop": "linux/com.kitsune.app.desktop"
        }
      }
    }
  }
}
